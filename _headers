# Cache policy (see README): long/immutable for the dictionary and pinned
# vendor bundle — rename those files when they change. Short for the app
# shell and config so updates land quickly.
/dict.json
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/
  Cache-Control: public, max-age=300
/index.html
  Cache-Control: public, max-age=300
/config.js
  Cache-Control: public, max-age=300
